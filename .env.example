# ===========================================
# FEATURE FLAG PLATFORM - VARIÁVEIS DE AMBIENTE
# ===========================================

# Copie este arquivo para .env e configure os valores

# AUTH SERVICE
# Master key para gerar API keys (use: openssl rand -hex 32)
MASTER_KEY=your-master-key-here

# SERVICE COMMUNICATION
# API key para comunicação entre serviços (use: openssl rand -hex 32)
SERVICE_API_KEY=your-service-api-key-here

# AWS LOCALSTACK (para testes locais)
# Nome da tabela DynamoDB para eventos de analytics
AWS_DYNAMODB_TABLE=evaluation_events

# OBSERVABILITY (apenas para produção/AWS)
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key-here

# DATABASE (já configurado no docker-compose.yml, apenas se precisar customizar)
# DATABASE_URL=postgres://postgres:postgres@postgres-auth:5432/auth_db
# FLAG_DB_URL=postgres://postgres:postgres@postgres-apps:5432/flags_db
# TARGETING_DB_URL=postgres://postgres:postgres@postgres-apps:5432/targeting_db

# REDIS (já configurado no docker-compose.yml)
# REDIS_HOST=redis
# REDIS_PORT=6379

# AWS LOCALSTACK (já configurado no docker-compose.yml)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# SQS_QUEUE_URL=http://localstack:4566/000000000000/evaluation-events

# PORTAS DOS SERVIÇOS (já configurado no docker-compose.yml)
# AUTH_SERVICE_PORT=8001
# FLAG_SERVICE_PORT=8002
# TARGETING_SERVICE_PORT=8003
# EVALUATION_SERVICE_PORT=8004
# ANALYTICS_SERVICE_PORT=8005
